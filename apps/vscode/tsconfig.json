{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    // esbuild is the bundler and emits CommonJS for the host; the sources stay ESM like
    // the rest of the workspace, which is what bundler resolution describes.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vscode"],
    "paths": {
      "@revlens/core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
